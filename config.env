# ============================================================
# CONFIGURACIÓ GENERAL DEL PROJECTE
# ============================================================
PROJECT_NAME="projecte-video"

# Guió d'entrada
SCRIPT_FILE="guio/guio.txt"

# Locució
VOICE_WAV="locucio/locucio.wav"
AUDIO_WITH_MUSIC="locucio/locucio-amb-musica.mp3"
USE_MUSIC=0
MUSIC_FILE=""
MUSIC_VOLUME=0.16

# Imatges / ComfyUI
COMFYUI_DIR="$HOME/Projectes/ComfyUI"
COMFYUI_URL="http://127.0.0.1:8188"
COMFYUI_HOST="127.0.0.1"
COMFYUI_PORT="8188"
COMFYUI_VENV=".venv"
PYTORCH_INDEX_URL="https://download.pytorch.org/whl/cu128"
IMAGE_DIR="imatges"
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
VISUAL_STYLE="còmic il·lustrat de 1936, línia de tinta clara, colors plans lleugerament apagats, ombres dibuixades, composició cinematogràfica, interior burgés valencià de 1936, vestuari històric detallat, alta qualitat"
CHARACTER_BIBLE="Referència de continuïtat quan apareguen: Carlos és un home jove, ros, prim i àgil, amb cabells rossos pentinats cap enrere i vestit burgés fosc de 1936; la Dona és jove, expressiva i segura, amb cabells foscos ondulats i vestit burgés clar de 1936. No inclogues cap personatge que no estiga descrit en l'escena."
NEGATIVE_PROMPT="text, subtítols, marca d'aigua, logotip, borrós, baixa qualitat, mans deformes, dits extra, anatomia incorrecta, cares deformes, personatges duplicats, persones extra, xiquets, xiquetes, grups, multitud, collage, fotografia moderna, roba moderna, objectes moderns"

# API TTS Matxa/Aina en Docker
TTS_API_URL="http://127.0.0.1:8000"
TTS_CONTAINER="crearvideo-aina-tts"
TTS_IMAGE="projecteaina/tts-api:latest"
TTS_PORT="8000"
TTS_VOICE="lluc"
TTS_LANGUAGE="ca-va"
VISUAL_ONLY_VOICE="quim"

# Vídeo mestre
MASTER_VIDEO="video/master.mp4"
MASTER_WIDTH=1080
MASTER_HEIGHT=1920
MASTER_FPS=30
TRANSITION_SECONDS=0.35
KEN_BURNS_ZOOM=1.08

# Vídeo comprimit
FINAL_VIDEO="video/final-15mb.mp4"
TARGET_MB=14.5
FINAL_HEIGHT=720
FINAL_FPS=24
AUDIO_BITRATE_K=64
MIN_VIDEO_BITRATE_K=90
MAX_VIDEO_BITRATE_K=2500

# Si no existeixen fragments WAV individuals, es repartirà la duració
# total de la locució entre totes les imatges.
