# ============================================================
# CONFIGURACIÓ GENERAL DEL PROJECTE
# ============================================================
PROJECT_NAME="projecte-video"

# Guió d'entrada
SCRIPT_FILE="guio/guio.txt"

# Locució
VOICE_WAV="locucio/locucio.wav"
AUDIO_WITH_MUSIC="locucio/locucio-amb-musica.mp3"
USE_MUSIC=0
MUSIC_FILE=""
MUSIC_VOLUME=0.16

# Imatges / ComfyUI
COMFYUI_DIR="$HOME/Projectes/ComfyUI"
COMFYUI_URL="http://127.0.0.1:8188"
COMFYUI_HOST="127.0.0.1"
COMFYUI_PORT="8188"
COMFYUI_VENV=".venv"
PYTORCH_INDEX_URL="https://download.pytorch.org/whl/cu128"
CHECKPOINT_NAME="DreamShaperXL_Turbo-Lightning.safetensors"
IMAGE_DIR="imatges"
IMAGE_WIDTH=1024
IMAGE_HEIGHT=768
VISUAL_STYLE="flat 2D Valencian comic-book illustration, graphic novel panel, hand-inked black line art, bold clean outlines, flat muted earth-color blocks, wide horizontal graphic poster composition, no painterly rendering, no sepia tone, no photograph"
CHARACTER_BIBLE="Continuïtat visual: mantín una aparença coherent del poeta, una paleta terrosa apagada i la continuïtat de la plaça, el camí de terra, el taller auster i l’estrela quan apareguen. Inclou únicament els personatges i objectes descrits explícitament en cada escena."
NEGATIVE_PROMPT="photorealistic, photograph, realistic photo, sepia, sepia tone, grayscale, monochrome, oil painting, watercolor, painterly rendering, live action, 3D render, text, letters, signature, subtitles, watermark, logo, blurry, low quality, collage, modern objects"

# API TTS Matxa/Aina en Docker
TTS_API_URL="http://127.0.0.1:8000"
TTS_CONTAINER="crearvideo-aina-tts"
TTS_IMAGE="projecteaina/tts-api:latest"
TTS_PORT="8000"
TTS_VOICE="gina"
TTS_LANGUAGE="ca-va"
VISUAL_ONLY_VOICE="quim"

# Vídeo mestre
MASTER_VIDEO="video/master.mp4"
MASTER_WIDTH=1080
MASTER_HEIGHT=1920
MASTER_FPS=30
TRANSITION_SECONDS=0.35
KEN_BURNS_ZOOM=1.08

# Vídeo comprimit
FINAL_VIDEO="video/final-15mb.mp4"
TARGET_MB=14.5
FINAL_HEIGHT=720
FINAL_FPS=24
AUDIO_BITRATE_K=64
MIN_VIDEO_BITRATE_K=90
MAX_VIDEO_BITRATE_K=2500

# Arxiu immutable dels vídeos acabats
VIDEO_ARCHIVE_DIR="videos-generats"
